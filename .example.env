# Ensure to keep these credentials secure and do not share them publicly
# Example values are provided; replace them with your actual credentials

# OpenRouter (https://openrouter.ai/keys) and the model to route to
OPENROUTER_API_KEY=sk-or-v1-...
LLM_MODEL=google/gemini-2.5-flash

# SQL configuration
# Replace with your actual SQL database credentials
SQL_HOST=your_mysql_host # e.g., localhost
SQL_USER=your_mysql_user
SQL_PASSWORD=your_mysql_password
SQL_DATABASE=your_mysql_database_name
SQL_PORT=3306 # Default MySQL port

# Langfuse tracing (optional; leave blank to disable)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://192.168.1.100:3040
